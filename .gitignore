# These are some examples of commonly ignored file patterns.
# You should customize this list as applicable to your project
# Learn more about .gitignore:
#     https://www.atlassian.com/git/tutorials/saving-changes/gitignore

# Node artifact files
node_modules/
dist/
.next/
.open-next/
.wrangler/*

# next.js
/.next/

.vercel
/.vercel/
/out/

# testing
/coverage

# environments
.env
.env.*

# production
/build

# Compiled Java class files
*.class

# Compiled Python bytecode
*.py[cod]

# Log files
*.log

# Package files
*.jar

# Maven
target/
dist/

# JetBrains IDE
.idea/

# Unit test reports
TEST*.xml

# Generated by MacOS
.DS_Store

# Generated by Windows
Thumbs.db

# Applications
*.app
*.exe
*.war

# Large media files
*.mp4
*.tiff
*.avi
*.flv
*.mov
*.wmv

# typescript
*.tsbuildinfo
next-env.d.ts

# JetBrains IDE
.idea/

# Visual Code IDE
.vscode

.docs/

# Sentry Config File
.env.sentry-build-plugin

# Cursor
skills-lock.json
.agents/

# Windsurf
.windsurf/

# docs
docs/
