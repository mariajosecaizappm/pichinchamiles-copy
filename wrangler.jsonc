{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "pichinchamiles-web",
	"compatibility_date": "2025-04-22",
	"compatibility_flags": [
		"nodejs_compat"
	],
	"main": ".open-next/worker.js",
	"assets": {
		"directory": ".open-next/assets",
		"binding": "ASSETS"
	},
	"build": {
		"command": "npx opennextjs-cloudflare build"
	},
	"observability": {
		"enabled": true
	},
